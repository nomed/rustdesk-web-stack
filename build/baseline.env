WEB_CLIENT_REPOSITORY=MonsieurBiche/rustdesk-web-client
WEB_CLIENT_REF=525b5e561faf824850c71500adf463e4e0a504d4

FLUTTER_VERSION=3.22.1
RUST_VERSION=1.97.0
ENABLE_WSS=true
