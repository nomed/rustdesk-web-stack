# RustDesk upstream source to build.
# Pin to a commit for reproducibility; update deliberately.
RUSTDESK_REPOSITORY=https://github.com/rustdesk/rustdesk.git
RUSTDESK_REF=c78bdefc44838301c7588be582a9a10e18a6cdf8

# The current RustDesk OSS tree no longer contains flutter/web. Use a pinned
# historical RustDesk-derived web-client tree only as the missing web scaffold;
# the application Dart/Rust sources still come from RUSTDESK_REPOSITORY above.
WEB_SCAFFOLD_REPOSITORY=https://github.com/pmietlicki/rustdesk-web-client.git
WEB_SCAFFOLD_REF=f5a090c27d529a17ccfaf984c061fbf71bffd841

# Matches the current default Flutter version in RustDesk's flutter-build workflow.
FLUTTER_VERSION=3.24.5

# Codec/dependency bundle referenced by RustDesk's disabled web-client build job.
WEB_DEPS_URL=https://github.com/rustdesk/doc.rustdesk.com/releases/download/console/web_deps.tar.gz
